<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="TourGuide">
  <BehaviorTree ID="DetectVisitor">
    <Sequence>
      <Fallback>
        <RetrieveListOfExhibits/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
        <SetRobotPose/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
        <SetAnimateBehavior name="enabled"/>
        <HandleFallBack/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="EndTour">
    <Sequence>
      <SelectExhibit/>
      <Fallback>
        <SetOvertAttentionMode name="social"/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
        <SayTextAsync name="4"
                      _description="That marks the last item ...."/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <NavigateAsync/>
          <HandleFallBack/>
        </Fallback>
        <SayTextAsync name="5"
                      _description="That&apos;s it from me ...."/>
      </Parallel>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <SayTextAsync name="8"
                        _description="I hope to meet you ....."/>
          <HandleFallBack/>
        </Fallback>
        <Fallback>
          <PerformIconicGestureAsync name="goodbye"/>
          <HandleFallBack/>
        </Fallback>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="EngageVisitor">
    <Sequence>
      <Fallback>
        <SetOvertAttentionMode name="social"/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
        <SetAnimateBehavior name="disabled"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="2">
        <Fallback>
          <SayTextAsync name="1"
                        _description="Welcome speech"/>
          <HandleFallBack/>
        </Fallback>
        <Fallback>
          <PerformIconicGestureAsync name="welcome"/>
          <HandleFallBack/>
        </Fallback>
      </Parallel>
      <Sequence>
        <Fallback>
          <RetrieveListOfExhibits/>
          <HandleFallBack/>
        </Fallback>
        <Sequence>
          <SelectExhibit/>
        </Sequence>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoHome">
    <Sequence>
      <Fallback>
        <RetrieveInitialLocation/>
        <HandleFallBack/>
      </Fallback>
      <SubTree ID="NavigateToLocation"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigateToLocation">
    <Sequence>
      <Fallback>
        <SetOvertAttentionMode name="disabled"/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
        <Navigate/>
        <HandleFallBack/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="QueryVisitorResponse">
    <Sequence>
      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Fallback>
                <SayTextAsync name="6"
                              _description="Query Tour Speech"/>
                <HandleFallBack/>
              </Fallback>
              <Fallback>
                    <GetVisitorResponse/>
                    <HandleFallBack/>
                </Fallback>
              <HasVisitorResponded/>
            </Sequence>
          </RetryUntilSuccessful>
          <IsVisitorResponseYes/>
        </Sequence>
        <ForceFailure>
          <Fallback>
            <SayTextAsync name="7"
                          _description="Maybe another time speech"/>
            <HandleFallBack/>
          </Fallback>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TourGuide">
    <Sequence>
      <StartOfTree _description="Used for debugging and initializing values"/>
      <SubTree ID="DetectVisitor"/>
      <SubTree ID="EngageVisitor"/>
      <SubTree ID="VisitExhibit"/>
      <SubTree ID="VisitExhibit_2"/>
      <SubTree ID="VisitExhibit_3"/>
      <SubTree ID="EndTour"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="VisitExhibit">
    <Sequence>
      <SelectExhibit/>
      <Fallback>
        <SetOvertAttentionMode name="disabled"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <NavigateAsync/>
          <HandleFallBack/>
        </Fallback>
        <SayTextAsync name="2"
                      _description="Now we move on ..."/>
      </Parallel>
      <Fallback>
        <SetOvertAttentionMode name="social"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <DescribeExhibitSpeechAsync/>
          <HandleFallBack/>
        </Fallback>
        <Fallback>
          <PerformDeicticGestureAsync/>
          <HandleFallBack/>
        </Fallback>
      </Parallel>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="VisitExhibit_2">
    <Sequence>
      <SelectExhibit/>
      <Fallback>
        <SetOvertAttentionMode name="disabled"/>
        <HandleFallBack/>
      </Fallback>
      <Fallback>
          <NavigateAsync/>
          <HandleFallBack/>
        </Fallback>
      <Fallback>
        <SetOvertAttentionMode name="social"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <DescribeExhibitSpeechAsync/>
          <HandleFallBack/>
        </Fallback>
        <Fallback>
          <PerformDeicticGestureAsync/>
          <HandleFallBack/>
        </Fallback>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="VisitExhibit_3">
    <Sequence>
      <SelectExhibit/>
      <Fallback>
        <SetOvertAttentionMode name="disabled"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <NavigateAsync/>
          <HandleFallBack/>
        </Fallback>
        <SayTextAsync name="3"
                      _description="Now we move on ..."/>
      </Parallel>
      <Fallback>
        <SetOvertAttentionMode name="social"/>
        <HandleFallBack/>
      </Fallback>
      <Parallel failure_count="1"
                success_count="-1">
        <Fallback>
          <DescribeExhibitSpeechAsync/>
          <HandleFallBack/>
        </Fallback>
        <Fallback>
          <PerformDeicticGestureAsync/>
          <HandleFallBack/>
        </Fallback>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DescribeExhibitSpeechAsync"
            editable="true"/>
    <Action ID="GetVisitorResponse"
            editable="true"/>
    <Action ID="HandleFallBack"
            editable="true"/>
    <Condition ID="HasVisitorResponded"
               editable="true"/>
    <Condition ID="IsVisitorResponseYes"
               editable="true"/>
    <Action ID="Navigate"
            editable="true"/>
    <Action ID="NavigateAsync"
            editable="true"/>
    <Action ID="PerformDeicticGestureAsync"
            editable="true"/>
    <Action ID="PerformIconicGestureAsync"
            editable="true"/>
    <Action ID="RetrieveInitialLocation"
            editable="true"/>
    <Action ID="RetrieveListOfExhibits"
            editable="true"/>
    <Action ID="SayTextAsync"
            editable="true"/>
    <Action ID="SelectExhibit"
            editable="true"/>
    <Action ID="SetAnimateBehavior"
            editable="true"/>
    <Action ID="SetOvertAttentionMode"
            editable="true"/>
    <Action ID="SetRobotPose"
            editable="true"/>
    <Action ID="StartOfTree"
            editable="true"/>
  </TreeNodesModel>

</root>
